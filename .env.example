# ---------------------------------------------------------------- LLM
# Any OpenAI-compatible, vision-capable chat model works.
OPENAI_API_KEY=sk-your-key-here
# Optional: point to Azure OpenAI, OpenRouter, Ollama (http://localhost:11434/v1), etc.
# OPENAI_BASE_URL=
LLM_MODEL=gpt-4.1-mini
# Leave empty for reasoning models that do not accept a temperature
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4000
REQUEST_TIMEOUT=120

# ---------------------------------------------------------------- documents
MAX_FILE_SIZE_MB=15
# Pages sent to the model per document (PDF / multi-page TIFF)
MAX_PAGES=5
IMAGE_MAX_SIDE=2000

# ---------------------------------------------------------------- server
DATABASE_PATH=./data/invoices.db
CORS_ORIGINS=*
LOG_LEVEL=INFO
